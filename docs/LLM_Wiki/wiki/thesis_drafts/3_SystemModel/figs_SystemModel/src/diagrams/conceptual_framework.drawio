        <mxCell id="card5" parent="panel_group" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E0;strokeWidth=1.2;fontFamily=Georgia, Times New Roman, serif;fontSize=11;fontColor=#1A202C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Atomic Checkpoint Pausing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#4A5568&quot;&gt;Native LangGraph interrupt() serializes full state tuple. Zero LLM tokens consumed during operator review dwell time.&lt;/font&gt;" vertex="1">
