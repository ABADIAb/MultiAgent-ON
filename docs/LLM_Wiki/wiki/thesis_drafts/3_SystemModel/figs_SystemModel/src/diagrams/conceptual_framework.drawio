        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EBF8FF;strokeColor=#3182CE;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" value="&lt;b&gt;Phase 2: CFG-Validated PDDL Parsing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;LLM Semantic Compiler → &lt;i&gt;S&lt;/i&gt;&lt;sub&gt;PDDL&lt;/sub&gt; + CFG AST Audit (&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;struct&lt;/sub&gt;)&lt;/font&gt;" vertex="1">
