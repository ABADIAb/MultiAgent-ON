        <mxCell id="card1" parent="panel_group" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E0;strokeWidth=1.2;fontFamily=Georgia, Times New Roman, serif;fontSize=11;fontColor=#1A202C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Fail-Fast Hierarchy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#4A5568&quot;&gt;Semantic ambiguity resolved in Gate 1 before executing costly topological graph pruning or GN-model physics.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="192" x="14" y="70" as="geometry" />
        </mxCell>
        <mxCell id="card2" parent="panel_group" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E0;strokeWidth=1.2;fontFamily=Georgia, Times New Roman, serif;fontSize=11;fontColor=#1A202C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Strict Neurosymbolic Separation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#4A5568&quot;&gt;LLM acts solely as a semantic compiler to PDDL. All routing and physical calculations are delegated to deterministic external engines.&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="192" x="14" y="205" as="geometry" />
        </mxCell>
        <mxCell id="card3" parent="panel_group" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E0;strokeWidth=1.2;fontFamily=Georgia, Times New Roman, serif;fontSize=11;fontColor=#1A202C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Zero Human Friction on Low Risk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#4A5568&quot;&gt;If &lt;i&gt;U&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; ≤ &lt;i&gt;τ&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; and QoT is valid, the pipeline auto-approves with 0 operator interruptions.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="192" x="14" y="345" as="geometry" />
        </mxCell>
        <mxCell id="card4" parent="panel_group" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E0;strokeWidth=1.2;fontFamily=Georgia, Times New Roman, serif;fontSize=11;fontColor=#1A202C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Pre-Deployment Safety Guarantee&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#4A5568&quot;&gt;No configuration reaches the physical network unless &lt;i&gt;D&lt;/i&gt;(&lt;i&gt;U&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt;, QoT&lt;sub&gt;valid&lt;/sub&gt;) = approve, precluding post-deployment failure.&lt;/font&gt;" vertex="1">
