        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDFDFD;strokeColor=#319795;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" value="&lt;b&gt;Phase 4: Deterministic Symbolic Solver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;Pruned topology &lt;i&gt;G̃&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt; + Yen&#39;s &lt;i&gt;K&lt;/i&gt;-Shortest Paths (&lt;i&gt;K&lt;/i&gt; = 5)&lt;/font&gt;" vertex="1">
