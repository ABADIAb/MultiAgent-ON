        </mxCell>
        <mxCell id="p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDFDFD;strokeColor=#319795;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" value="&lt;b&gt;Phase 5: Deterministic QoT Validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;Analytical Coherent GN Model: GSNR &amp;amp; &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;rx&lt;/sub&gt; calculation&lt;/font&gt;" vertex="1">
