        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EBF8FF;strokeColor=#3182CE;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" value="&lt;b&gt;Phase 1: Intent Ingestion &amp;amp; Optical RAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;Raw intent &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;NL&lt;/sub&gt; + &lt;i&gt;k&lt;/i&gt;-hop subtopology &lt;i&gt;G&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt; context extraction&lt;/font&gt;" vertex="1">
