        <mxCell id="panel_group" parent="1" style="swimlane;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F7FAFC;strokeColor=#CBD5E0;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=12.5;fontColor=#2D3748;collapsible=0;perimeterSpacing=0;startSize=40;" value="&lt;b&gt;Architectural Invariants &amp;amp; Guarantees&lt;/b&gt;" vertex="1">
