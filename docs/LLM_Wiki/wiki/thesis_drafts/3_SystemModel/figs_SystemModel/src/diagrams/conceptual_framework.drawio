        <mxCell id="g1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#B7791F;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#744210;align=center;verticalAlign=middle;" value="&lt;b&gt;GATE 1: Semantic Uncertainty Gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;i&gt;&lt;i&gt;U&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; = &lt;i&gt;f&lt;/i&gt;(&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;struct&lt;/sub&gt;, &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt;) ≤ &lt;i&gt;τ&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; (0.30) ?&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="336" x="412" y="316" as="geometry" />
        </mxCell>
        <mxCell id="p3b" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEEBC8;strokeColor=#DD6B20;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#1A202C;align=center;verticalAlign=middle;" value="&lt;b&gt;Phase 3b: HITL Clarify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;LangGraph interrupt()&lt;br&gt;Operator resolves ambiguity&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="228" x="132" y="301" as="geometry" />
