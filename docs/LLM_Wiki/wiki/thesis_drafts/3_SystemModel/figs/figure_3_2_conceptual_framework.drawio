        <mxCell id="prop_0" value="&lt;b&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;Orthogonal Gating:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5568&quot; style=&quot;font-size:11px;&quot;&gt;Decouples linguistic ambiguity (Gate 1)&lt;br&gt;from physical propagation feasibility (Gate 2).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Georgia, Times New Roman, serif;fontSize=12;" vertex="1" parent="1">
  <mxGeometry x="719" y="159" width="282" height="75" as="geometry" />
</mxCell>
        <mxCell id="prop_1" value="&lt;b&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;Zero-Overhead Autonomy:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5568&quot; style=&quot;font-size:11px;&quot;&gt;When &lt;i&gt;U&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; ≤ 0.30 and QoT passes,&lt;br&gt;execution completes with 0 human pauses.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Georgia, Times New Roman, serif;fontSize=12;" vertex="1" parent="1">
  <mxGeometry x="719" y="247" width="282" height="75" as="geometry" />
</mxCell>
        <mxCell id="prop_2" value="&lt;b&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;Deterministic Physics:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5568&quot; style=&quot;font-size:11px;&quot;&gt;GN model physics calculations never&lt;br&gt;run on hallucinatory paths.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Georgia, Times New Roman, serif;fontSize=12;" vertex="1" parent="1">
  <mxGeometry x="719" y="335" width="282" height="75" as="geometry" />
</mxCell>
        <mxCell id="prop_3" value="&lt;b&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;Protected Control Plane:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5568&quot; style=&quot;font-size:11px;&quot;&gt;No unverified commands ever reach&lt;br&gt;the SDON controller or ROADM hardware.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Georgia, Times New Roman, serif;fontSize=12;" vertex="1" parent="1">
  <mxGeometry x="719" y="423" width="282" height="75" as="geometry" />
</mxCell>
