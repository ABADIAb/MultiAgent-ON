        <mxCell id="panel_title" value="&lt;b&gt;Fail-Fast Properties&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Georgia, Times New Roman, serif;fontSize=15;fontColor=#2D3748;" vertex="1" parent="1">
