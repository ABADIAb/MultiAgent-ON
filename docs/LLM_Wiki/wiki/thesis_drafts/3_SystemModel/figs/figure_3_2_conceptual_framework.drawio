  <diagram id="fig_3_2" name="Figure 3.2: Conceptual Framework">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1" value="&lt;b&gt;Phase 1: Intent Ingestion &amp; Optical RAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;Raw intent &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;NL&lt;/sub&gt; + &lt;i&gt;k&lt;/i&gt;-hop subtopology &lt;i&gt;G&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt; extraction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EBF8FF;strokeColor=#3182CE;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="304" y="36" width="352" height="60" as="geometry" />
</mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2: CFG-Validated PDDL Parsing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;LLM Semantic Compiler → &lt;i&gt;S&lt;/i&gt;&lt;sub&gt;PDDL&lt;/sub&gt; + AST Audit (&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;struct&lt;/sub&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EBF8FF;strokeColor=#3182CE;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="304" y="128" width="352" height="60" as="geometry" />
</mxCell>
        <mxCell id="p3a" value="&lt;b&gt;Phase 3a: Automated Reverse Prompting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;Autonomous PDDL → &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;recon&lt;/sub&gt; (0 interrupts, LLM reconstruction)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#805AD5;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="304" y="220" width="352" height="60" as="geometry" />
</mxCell>
        <mxCell id="g1" value="&lt;b&gt;GATE 1: Semantic Gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;i&gt;&lt;i&gt;U&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; = &lt;i&gt;f&lt;/i&gt;(&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;struct&lt;/sub&gt;, &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt;) ≤ &lt;i&gt;τ&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; ?&lt;/i&gt;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#B7791F;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#744210;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="312" y="324" width="336" height="80" as="geometry" />
</mxCell>
        <mxCell id="p3b" value="&lt;b&gt;Phase 3b: HITL Clarify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;LangGraph interrupt()&lt;br&gt;Operator resolves ambiguity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEEBC8;strokeColor=#DD6B20;strokeWidth=1.6;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="48" y="328" width="192" height="72" as="geometry" />
</mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4: Deterministic Symbolic Solver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;Pruned topology &lt;i&gt;G̃&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt; + Yen&#x27;s K-Shortest Paths (&lt;i&gt;K&lt;/i&gt; = 5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDFDFD;strokeColor=#319795;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="304" y="416" width="352" height="60" as="geometry" />
</mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5: Deterministic QoT Validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;Analytical Coherent GN Model: GSNR &amp; &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;rx&lt;/sub&gt; calculation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDFDFD;strokeColor=#319795;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="304" y="508" width="352" height="60" as="geometry" />
</mxCell>
        <mxCell id="g2" value="&lt;b&gt;GATE 2: Physical Risk Gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;i&gt;QoT&lt;sub&gt;valid&lt;/sub&gt;(&lt;i&gt;π&lt;/i&gt;) = 1 ? (GSNR ≥ GSNR&lt;sub&gt;th&lt;/sub&gt;)&lt;/i&gt;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#B7791F;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#744210;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="312" y="616" width="336" height="80" as="geometry" />
</mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6: Suggest Replan (RADG)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;LangGraph interrupt()&lt;br&gt;Relax constraints / modulation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FED7D7;strokeColor=#E53E3E;strokeWidth=1.6;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="48" y="620" width="192" height="72" as="geometry" />
</mxCell>
        <mxCell id="p7" value="&lt;b&gt;Phase 7: Plan Synthesis &amp; Provisioning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#4A5568&quot;&gt;Auditable Planning Report + RESTCONF / NETCONF Dispatch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0FFF4;strokeColor=#38A169;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=13;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1">
