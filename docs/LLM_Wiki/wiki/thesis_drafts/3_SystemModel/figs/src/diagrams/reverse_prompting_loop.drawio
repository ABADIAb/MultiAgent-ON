<mxfile host="Electron" agent="5.0">
  <diagram id="fig_reverse_prompting_loop" name="Closed-Loop Reverse Prompting Validation Invariant">
    <mxGraphModel dx="1100" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="680" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_intent" value="&lt;b&gt;Operator Intent (Natural Language)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#2B6CB0&quot;&gt;&lt;i&gt;I&lt;/i&gt;&lt;sub&gt;NL&lt;/sub&gt;: &quot;Route Hamburg to Leipzig, avoid Hannover, min GSNR 15 dB&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EBF8FF;strokeColor=#3182CE;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="50" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="n_fwd" value="&lt;b&gt;Forward Formal Translation: &lt;i&gt;M&lt;/i&gt;&lt;sub&gt;forward&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#2C5282&quot;&gt;Primary LLM translates &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;NL&lt;/sub&gt; into formal PDDL syntax &lt;i&gt;S&lt;/i&gt;&lt;sub&gt;PDDL&lt;/sub&gt;&lt;br&gt;Bounded by optical sub-graph &lt;i&gt;G&lt;/i&gt;&lt;sub&gt;sub&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EBF8FF;strokeColor=#3182CE;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="n_pddl" value="&lt;b&gt;Formal PDDL Predicates: &lt;i&gt;S&lt;/i&gt;&lt;sub&gt;PDDL&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#553C9A&quot;&gt;(route Hamburg Leipzig)&lt;br&gt;(avoid-node Hannover)&lt;br&gt;(min-gsnr 15.0)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAF5FF;strokeColor=#805AD5;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=11.5;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="160" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="n_rev" value="&lt;b&gt;Reverse Reconstruction: &lt;i&gt;M&lt;/i&gt;&lt;sub&gt;reverse&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#553C9A&quot;&gt;Autonomous generative translation of &lt;i&gt;S&lt;/i&gt;&lt;sub&gt;PDDL&lt;/sub&gt; back to NL&lt;br&gt;Zero operator interrupts: yields &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;recon&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAF5FF;strokeColor=#805AD5;strokeWidth=1.4;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="n_recon" value="&lt;b&gt;Reconstructed Intent: &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;recon&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#4A5568&quot;&gt;&quot;Provision a lightpath connecting Hamburg to Leipzig while strictly circumventing node Hannover with at least 15 dB GSNR.&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=1.3;fontFamily=Georgia, Times New Roman, serif;fontSize=11;fontColor=#1A202C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="270" width="290" height="75" as="geometry" /></mxCell>
        <mxCell id="n_gate" value="&lt;b&gt;Semantic Agreement Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#744210&quot;&gt;Computes Semantic Divergence Scalar: &lt;i&gt;d&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; ∈ [0, 1]&lt;br&gt;Compares &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;NL&lt;/sub&gt; against &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;recon&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEFCBF;strokeColor=#D69E2E;strokeWidth=1.6;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#744210;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="340" height="65" as="geometry" /></mxCell>
        <mxCell id="n_hitl" value="&lt;b&gt;LangGraph interrupt()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#7B341E&quot;&gt;[&lt;i&gt;d&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; &amp;gt; &lt;i&gt;τ&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt;] Human Review Triggered&lt;br&gt;Presents &lt;i&gt;I&lt;/i&gt;&lt;sub&gt;recon&lt;/sub&gt; to Operator for Refinement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FEEBC8;strokeColor=#DD6B20;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=11.5;fontColor=#7B341E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="300" height="65" as="geometry" /></mxCell>
        <mxCell id="n_pass" value="&lt;b&gt;Autonomous Execution Pass&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#22543D&quot;&gt;[&lt;i&gt;d&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt; ≤ &lt;i&gt;τ&lt;/i&gt;&lt;sub&gt;sem&lt;/sub&gt;] Perfect Alignment&lt;br&gt;Direct handoff to Phase 4: Symbolic Solver&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F0FFF4;strokeColor=#38A169;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=11.5;fontColor=#22543D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="480" width="300" height="65" as="geometry" /></mxCell>
        <mxCell id="e_feedback" value="Operator Refined Feedback F (Loopback to Phase 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD6B20;strokeWidth=1.5;dashed=1;fontFamily=Georgia, Times New Roman, serif;fontSize=10.5;fontColor=#7B341E;endArrow=block;endFill=1;" edge="1" source="n_hitl" target="n_fwd" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="512" /><mxPoint x="40" y="195" /></Array></mxGeometry></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="n_intent" target="n_fwd" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="n_fwd" target="n_pddl" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#805AD5;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="n_pddl" target="n_rev" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#805AD5;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="n_rev" target="n_recon" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D69E2E;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="n_recon" target="n_gate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;strokeWidth=1.3;dashed=1;endArrow=block;endFill=1;" edge="1" source="n_intent" target="n_gate" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="80" /><mxPoint x="490" y="380" /></Array></mxGeometry></mxCell>
        <mxCell id="e_to_hitl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD6B20;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="n_gate" target="n_hitl" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_to_pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38A169;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="n_gate" target="n_pass" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
