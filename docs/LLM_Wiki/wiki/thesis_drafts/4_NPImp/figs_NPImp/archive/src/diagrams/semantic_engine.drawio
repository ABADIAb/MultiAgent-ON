        </mxCell>
        <mxCell id="e_pddl_ast" parent="layer1_group" value="&lt;i&gt;S&lt;/i&gt;&lt;sub&gt;PDDL&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;strokeWidth=1.5;fontFamily=Georgia, Times New Roman, serif;fontSize=12;fontColor=#2B6CB0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" source="pddl_llm" target="ast_parser">
